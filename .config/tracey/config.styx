@schema {id crate:tracey-config@1, cli tracey}

specs (
    {
        name cli
        source_url https://github.com/TeamDman/teamy-subs
        include (docs/spec/cli/**/*.md)
        impls (
            {
                name rust
                include (
                    src/**/*.rs
                    crates/**/*.rs
                )
                exclude (
                    target/**
                )
                test_include (
                    tests/**/*.rs
                    crates/**/tests/**/*.rs
                )
            }
        )
    }
    {
        name vtt
        source_url https://github.com/TeamDman/teamy-subs
        include (docs/spec/vtt/**/*.md)
        impls (
            {
